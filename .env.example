# ==============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub — it's already in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ANTHROPIC API KEY (required)
# ------------------------------------------------------------------------------
# Get one at: https://console.anthropic.com/settings/keys
# This is DIFFERENT from your claude.ai subscription — it's billed per token,
# usually a few cents per job scored/tailored.
# Format: starts with sk-ant-
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL -- only needed if the Google site: search scraper (src/scrapers/
# google_ats.py) errors with "This API key is not scoped to a workspace".
# That means your key was created at the organization level rather than
# inside a specific workspace, and Claude's web_search tool needs a
# workspace context. Fix by finding your workspace ID at
# console.anthropic.com/settings/workspaces (or generating a new API key
# from inside a specific workspace instead) and setting it here.
ANTHROPIC_WORKSPACE_ID=

# ------------------------------------------------------------------------------
# 2. SECONDARY LINKEDIN ACCOUNT (required for LinkedIn scraping)
# ------------------------------------------------------------------------------
# Use a SEPARATE account from your real profile — not your main LinkedIn.
# This account exists only to search and read job postings. If it gets rate
# limited or flagged, you replace it — your real LinkedIn is never touched.
SCRAPER_LINKEDIN_USERNAME=your-secondary-email@gmail.com
SCRAPER_LINKEDIN_PASSWORD=your-secondary-password

# ------------------------------------------------------------------------------
# 3. SECONDARY INDEED ACCOUNT (required for Indeed scraping)
# ------------------------------------------------------------------------------
# Same idea — a throwaway/secondary account, not your main one.
SCRAPER_INDEED_USERNAME=your-secondary-email@gmail.com
SCRAPER_INDEED_PASSWORD=your-secondary-password

# ------------------------------------------------------------------------------
# 4. OPTIONAL — Email alerts when new high-score jobs appear
# ------------------------------------------------------------------------------
# Leave ALERT_EMAIL_ENABLED=false if you don't want this. Safe to skip entirely.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=your-real-email@gmail.com
ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-real-email@gmail.com
ALERT_SMTP_PASSWORD=your-gmail-app-password

# ------------------------------------------------------------------------------
# 5. OPTIONAL — Slack alerts
# ------------------------------------------------------------------------------
# Leave ALERT_SLACK_ENABLED=false if you don't want this. Safe to skip entirely.
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url

# ------------------------------------------------------------------------------
# 6. OPTIONAL — FlexJobs (only if you have a paid subscription)
# ------------------------------------------------------------------------------
# FlexJobs requires a paid account. Leave blank to skip this source entirely.
FLEXJOBS_API_KEY=

# ------------------------------------------------------------------------------
# 7. Dashboard settings (defaults are fine, change only if you know why)
# ------------------------------------------------------------------------------
DASHBOARD_PORT=9009
SCRAPE_WINDOW_HOURS=24
SCRAPE_WINDOW_FALLBACK_HOURS=48
